<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <!-- ═══ Dialog de selección de actividad SIN ═══ -->
    <t t-name="l10n_bo_pos_custom.SinActivityDialog">
        <Dialog title="props.title" size="'medium'" contentClass="'pos-dialog'">
            <div class="sin-activity-dialog p-3">
                <p class="text-muted mb-3">
                    Seleccione la actividad económica para esta sesión del POS:
                </p>
                <div class="d-flex flex-column gap-2">
                    <t t-foreach="props.activities" t-as="act" t-key="act.id">
                        <button
                            class="btn btn-outline-primary text-start p-3"
                            t-att-class="{'active btn-primary': state.selectedId === act.id}"
                            t-on-click="() => this.selectActivity(act)">
                            <div class="fw-bold" t-esc="act.name"/>
                            <div class="text-muted small">
                                Actividad: <span t-esc="act.actividad_economica"/>
                            </div>
                        </button>
                    </t>
                </div>
            </div>
            <t t-set-footer="">
                <button class="btn btn-secondary" t-on-click="() => this.onCancel()">
                    Cancelar
                </button>
                <button class="btn btn-primary"
                        t-att-disabled="!state.selectedId"
                        t-on-click="() => this.onConfirm()">
                    Aceptar
                </button>
            </t>
        </Dialog>
    </t>

    <!-- ═══ Sección SIN en el receipt ═══ -->
    <!-- Se inyecta en el template OrderReceipt via t-inherit -->
    <t t-inherit="point_of_sale.OrderReceipt" t-inherit-mode="primary">
        <xpath expr="//div[@class='before-footer']" position="before">
            <!-- ════ SECCIÓN SIN ════ -->
            <t t-set="sinData" t-value="sinData"/>
            <t t-if="sinData">
                <div class="sin-receipt-section mt-3 pt-3"
                     style="border-top: 1px dashed #999;">
                    <!-- Emisor / Datos SIN -->
                    <div class="text-start pb-1" style="font-size: 80%;">
                        <div class="fw-bold mb-1"
                             style="letter-spacing: 1px;">
                            ════ DATOS SIN ════
                        </div>
                        <div class="d-flex justify-content-between">
                            <span class="text-muted">Estado:</span>
                            <span class="fw-bold"
                                  t-att-class="{'text-success': sinData.state === 'sent', 'text-danger': sinData.state === 'error', 'text-warning': sinData.state === 'sending'}">
                                <t t-esc="sinData.stateLabel"/>
                            </span>
                        </div>
                        <t t-if="sinData.hasCuf">
                            <div class="mt-1">
                                <span class="text-muted">CUF:</span>
                            </div>
                            <div style="font-size: 75%; word-break: break-all;
                                        font-family: monospace; line-height: 1.3;"
                                 t-esc="sinData.cuf"/>
                        </t>
                        <t t-if="sinData.message and sinData.state === 'error'">
                            <div class="mt-1 text-danger" style="font-size: 75%;"
                                 t-esc="sinData.message"/>
                        </t>
                    </div>
                </div>
            </t>
            <!-- ═══ FIN SECCIÓN SIN ═══ -->
        </xpath>
    </t>

</templates>
