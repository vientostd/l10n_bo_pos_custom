<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_sin_config_form_sin_select" model="ir.ui.view">
        <field name="name">sin.config.form.select.activity</field>
        <field name="model">sin.config</field>
        <field name="inherit_id" ref="l10n_bo_electronic_invoice.view_sin_config_form"/>
        <field name="arch" type="xml">
            <field name="actividad_economica" position="replace">
                <field name="sin_activity_id"
                       options="{'no_create': True}"
                       placeholder="Seleccione la actividad económica"/>
            </field>
            <xpath expr="//field[@name='activity_catalog_ids']" position="after">
                <button name="action_ensure_activity_configs"
                        type="object"
                        class="btn-link"
                        icon="fa-refresh"
                        string="Asegurar actividades POS"
                        help="Crea (si faltan) las configuraciones POS de las
                              actividades autorizadas por el SIN. No modifica
                              las existentes."/>
            </xpath>
        </field>
    </record>
</odoo>