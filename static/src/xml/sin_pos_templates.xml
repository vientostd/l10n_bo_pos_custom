<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <!-- ═══ Activity badge in Navbar header ═══ -->
    <t t-name="l10n_bo_pos_custom.SinNavbarBadge"
       t-inherit="point_of_sale.Navbar"
       t-inherit-mode="extension">
        <xpath expr="//div[contains(@class, 'status-buttons')]" position="before">
            <t t-if="pos.selectedSinActivity and pos.config.sin_enabled">
                <div class="sin-activity-badge d-flex align-items-center gap-1 px-2 py-1 rounded"
                     style="cursor: pointer; background: #e8f4f8; border: 1px solid #b8d4e3; font-size: 0.85em; color: #2a6496;"
                     t-on-click="() => this.switchSinActivity()"
                     title="Actividad económica: cambiar">
                    <i class="fa fa-briefcase"/>
                    <span class="fw-bold" t-esc="sinActivityAlias || sinActivityName"/>
                    <span class="badge bg-light text-dark border ms-1"
                          style="font-size: 0.85em;"
                          t-esc="sinActivityCodigo || ''"/>
                    <span class="d-none d-xl-inline small text-muted"
                          t-esc="sinActivityName || ''"/>
                </div>
            </t>
        </xpath>
    </t>

    <!-- ═══ Dialog de seleccion de actividad SIN ═══ -->
    <t t-name="l10n_bo_pos_custom.SinActivityDialog">
        <Dialog title="props.title || 'Actividad Economica'" size="'md'" contentClass="'pos-dialog'" footer="true">
            <div class="sin-activity-dialog p-3">
                <p class="text-muted mb-3">
                    Seleccione la actividad economica para esta sesion del POS:
                </p>
                <div t-if="state.loading" class="text-center py-3">
                    <i class="fa fa-spinner fa-spin fa-2x"/>
                    <div class="mt-2">Cargando actividades...</div>
                </div>
                <div t-elif="state.activities.length === 0" class="text-center py-3 text-danger">
                    No se encontraron actividades disponibles.
                </div>
                <div t-else="" class="d-flex flex-column gap-2">
                    <t t-foreach="state.activities" t-as="act" t-key="act.id">
                        <button
                            class="btn btn-outline-primary text-start p-3"
                            t-att-class="{'active btn-primary': state.selectedId === act.id}"
                            t-on-click="() => this.selectActivity(act)">
                            <div class="d-flex justify-content-between align-items-center">
                                <div>
                                    <div class="fw-bold" t-esc="act.name"/>
                                    <div class="text-muted small">
                                        Actividad: <span t-esc="act.actividad_economica"/>
                                    </div>
                                </div>
                                <t t-if="act.alias">
                                    <span class="badge bg-info text-white ms-2"
                                          style="font-size: 0.8em;"
                                          t-esc="act.alias"/>
                                </t>
                            </div>
                        </button>
                    </t>
                </div>
            </div>
            <t t-set-slot="footer">
                <button class="btn btn-secondary" t-on-click="() => this.onCancel()">
                    Cancelar
                </button>
                <button class="btn btn-primary"
                        t-att-disabled="!state.selectedId"
                        t-on-click="() => this.onConfirm()">
                    Aceptar
                </button>
            </t>
        </Dialog>
    </t>

    <!-- ═══ (Seccion SIN en el receipt: ELIMINADA — el modulo
         l10n_bo_electronic_invoice ya renderiza el receipt SIN completo
         con QR, leyenda, polling y boton hoja carta. Esta extension
         duplicaba ese bloque y competia por el getter sinData.) ═══ -->
<!-- ============================================================
     DESCUENTO GENERAL SIN (2026-09-21) - fix t-att-disabled
     Boton "Descuento General" + dialogo % / Bs
     ============================================================ -->
    <t t-name="l10n_bo_pos_custom.SinGlobalDiscountButton"
       t-inherit="point_of_sale.ProductScreen"
       t-inherit-mode="extension">
        <xpath expr="//div[hasclass('pads')]" position="before">
            <div class="d-flex px-2 pt-2" t-if="pos.config.sin_enabled">
                <button class="btn btn-outline-secondary w-100"
                        t-on-click="() => this.openGlobalDiscountDialog()"
                        title="Aplica un descuento a toda la orden (se envia al SIN por linea)">
                    <i class="fa fa-percent me-1"/>
                    Descuento General
                </button>
            </div>
        </xpath>
    </t>

    <t t-name="l10n_bo_pos_custom.SinGlobalDiscountDialog">
        <Dialog title="'Descuento General'" size="'md'" contentClass="'pos-dialog'" footer="true">
            <div class="sin-global-discount-dialog p-3">
                <p class="text-muted mb-3">
                    Aplica un descuento a todas las lineas de la orden.
                    Reemplaza los descuentos individuales de cada producto.
                </p>
                <div class="btn-group w-100 mb-3">
                    <button
                        t-on-click="() => this.onMode('percent')"
                        t-att-class="'btn ' + (state.mode === 'percent' ? 'btn-primary' : 'btn-secondary')">
                        %
                    </button>
                    <button
                        t-on-click="() => this.onMode('amount')"
                        t-att-class="'btn ' + (state.mode === 'amount' ? 'btn-primary' : 'btn-secondary')">
                        Bs
                    </button>
                </div>
                <div class="d-flex align-items-center gap-2">
                    <input
                        type="number"
                        min="0"
                        step="0.01"
                        class="form-control form-control-lg text-end"
                        t-model="state.value"
                        placeholder="0"/>
                    <span class="fs-4" t-esc="state.mode === 'percent' ? '%' : 'Bs'"/>
                </div>
                <div class="mt-3 d-flex justify-content-between small text-muted">
                    <span>Total actual: <span t-esc="currentTotal"/></span>
                    <span>Total estimado: <span t-esc="estimatedTotal"/></span>
                </div>
            </div>
            <t t-set-slot="footer">
                <button class="btn btn-secondary" t-on-click="() => this.onCancel()">
                    Cancelar
                </button>
                <button class="btn btn-danger" t-on-click="() => this.onClear()">
                    Quitar (0%)
                </button>
                <button class="btn btn-primary"
                        t-att-disabled="canApply ? false : true"
                        t-on-click="() => this.onConfirm()">
                    Aplicar
                </button>
            </t>
        </Dialog>
    </t>

</templates>
